        function openTransferModal() {
            const inventory = getDB(DB_KEYS.inventory);
            const modalHTML = `
                <div class="modal-header"><h3>📦 Transfer Stock</h3><button class="modal-close" onclick="closeModal()">✕</button></div>
                <div class="modal-body">
                    <div class="form-group"><label>Stock Item</label>
                        <select id="t_item">${inventory.map(i => `<option value="${i.id}">${i.grade} - ${i.warehouse} (${i.kgs} kg)</option>`).join('')}</select>
                    </div>
                    <div class="form-row">
                        <div class="form-group"><label>Sacks to Transfer</label><input type="number" id="t_sacks" min="1" value="1"></div>
                        <div class="form-group"><label>To Warehouse</label><select id="t_to"><option>Kisenyi Store 1</option><option>Kisenyi Store 2</option><option>Nakawa</option></select></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                    <button class="btn btn-primary" onclick="saveTransfer()">Transfer</button>
                </div>
            `;
            document.getElementById('modalContent').innerHTML = modalHTML;
            document.getElementById('modalOverlay').style.display = 'flex';
        }

        function saveTransfer() {
            const itemId = document.getElementById('t_item')?.value;
            const sacks = parseInt(document.getElementById('t_sacks')?.value) || 0;
            const toWarehouse = document.getElementById('t_to')?.value;
            if (!itemId || sacks <= 0) { showToast('Invalid transfer details', 'error'); return; }

            const inventory = getDB(DB_KEYS.inventory);
            const item = inventory.find(i => i.id === itemId);
            if (!item || item.sacks < sacks) { showToast('Not enough sacks to transfer', 'error'); return; }

            item.sacks -= sacks;
            const kgsToTransfer = sacks * 100;
            item.kgs -= kgsToTransfer;

            const newItem = {
                ...item,
                id: generateId('inv'),
                warehouse: toWarehouse,
                sacks: sacks,
                kgs: kgsToTransfer,
                _seq: getNextId(DB_KEYS.inventory),
            };
            inventory.push(newItem);
            setDB(DB_KEYS.inventory, inventory);

            const transfers = getDB(DB_KEYS.transfers);
            transfers.unshift({ id: generateId('tr'), fromItem: itemId, toWarehouse, sacks, kgs: kgsToTransfer,
                date: todayStr(), _seq: getNextId(DB_KEYS.transfers) });
            setDB(DB_KEYS.transfers, transfers);

            const currentUser = getCurrentUser();
            logActivity(currentUser?.name || 'System', `Transferred ${sacks} sacks to ${toWarehouse}`);
            closeModal();
            showToast('Stock transferred successfully!', 'success');
            renderInventory();
        }

