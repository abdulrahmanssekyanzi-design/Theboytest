        function calcPurchaseNet() {
            const gross = parseFloat(document.getElementById('p_gross')?.value) || 0;
            const tare = parseFloat(document.getElementById('p_tare')?.value) || 0;
            const moisture = parseFloat(document.getElementById('p_moisture')?.value) || 0;
            const stones = parseFloat(document.getElementById('p_stones')?.value) || 0;
            const badNuts = parseFloat(document.getElementById('p_badNuts')?.value) || 0;

            const net = gross - tare;
            const moistureDeduction = net * (moisture / 100);
            const finalKg = Math.max(0, net - moistureDeduction - stones - badNuts);

            if (document.getElementById('p_net')) document.getElementById('p_net').value = net.toFixed(1);
            if (document.getElementById('p_finalKg')) document.getElementById('p_finalKg').value = finalKg.toFixed(1);

            const price = parseFloat(document.getElementById('p_price')?.value) || 0;
            const transport = parseFloat(document.getElementById('p_transport')?.value) || 0;
            const offloading = parseFloat(document.getElementById('p_offloading')?.value) || 0;
            const total = finalKg * price + transport + offloading;
            if (document.getElementById('p_total')) document.getElementById('p_total').value = total.toFixed(0);
            calcPurchaseBalance();
        }

        function calcPurchaseBalance() {
            const total = parseFloat(document.getElementById('p_total')?.value) || 0;
            const paid = parseFloat(document.getElementById('p_amountPaid')?.value) || 0;
            if (document.getElementById('p_balance')) document.getElementById('p_balance').value = Math.max(0, total - paid)
                .toFixed(0);
        }

        function savePurchase() {
            const supplierId = document.getElementById('p_supplier')?.value;
            if (!supplierId) { showToast('Please select a supplier', 'error'); return; }
            if (supplierId === '__new') {
                const name = prompt('Enter new supplier name:');
                if (!name) return;
                const suppliers = getDB(DB_KEYS.suppliers);
                const newSup = { id: generateId('sup'), name, phone: '', district: 'Lira', village: '', _seq: getNextId(
                        DB_KEYS.suppliers) };
                suppliers.push(newSup);
                setDB(DB_KEYS.suppliers, suppliers);
                // Re-open with new supplier selected
                openPurchaseModal();
                document.getElementById('p_supplier').value = newSup.id;
                return;
            }

            const purchase = {
                id: generateId('pur'),
                supplierId,
                date: document.getElementById('p_date')?.value || todayStr(),
                truckNo: document.getElementById('p_truck')?.value || '',
                sackType: document.getElementById('p_sackType')?.value || '100kg',
                grossWeight: parseFloat(document.getElementById('p_gross')?.value) || 0,
                tareWeight: parseFloat(document.getElementById('p_tare')?.value) || 0,
                netWeight: parseFloat(document.getElementById('p_net')?.value) || 0,
                moisturePct: parseFloat(document.getElementById('p_moisture')?.value) || 0,
                stonesKg: parseFloat(document.getElementById('p_stones')?.value) || 0,
                badNutsKg: parseFloat(document.getElementById('p_badNuts')?.value) || 0,
                finalKg: parseFloat(document.getElementById('p_finalKg')?.value) || 0,
                pricePerKg: parseFloat(document.getElementById('p_price')?.value) || 0,
                transportCost: parseFloat(document.getElementById('p_transport')?.value) || 0,
                offloadingCost: parseFloat(document.getElementById('p_offloading')?.value) || 0,
                totalPayable: parseFloat(document.getElementById('p_total')?.value) || 0,
                paymentStatus: document.getElementById('p_paymentStatus')?.value || 'Full',
                amountPaid: parseFloat(document.getElementById('p_amountPaid')?.value) || 0,
                balance: parseFloat(document.getElementById('p_balance')?.value) || 0,
                warehouse: document.getElementById('p_warehouse')?.value || 'Kisenyi Store 1',
                _seq: getNextId(DB_KEYS.purchases),
            };

            const purchases = getDB(DB_KEYS.purchases);
            purchases.unshift(purchase);
            setDB(DB_KEYS.purchases, purchases);

            // Add to inventory
            const inventory = getDB(DB_KEYS.inventory);
            const invItem = {
                id: generateId('inv'),
                grade: 'Unsorted',
                warehouse: purchase.warehouse,
                sacks: Math.ceil(purchase.finalKg / 100),
                kgs: purchase.finalKg,
                trueCostPerKg: purchase.totalPayable / purchase.finalKg || 0,
                source: 'Purchase',
                sourceId: purchase.id,
                _seq: getNextId(DB_KEYS.inventory),
            };
            inventory.push(invItem);
            setDB(DB_KEYS.inventory, inventory);

            // If credit, update supplier balance
            if (purchase.paymentStatus !== 'Full' && purchase.balance > 0) {
                const suppliers = getDB(DB_KEYS.suppliers);
                const sup = suppliers.find(s => s.id === supplierId);
                if (sup) {
                    sup.balance = (sup.balance || 0) + purchase.balance;
                    setDB(DB_KEYS.suppliers, suppliers);
                }
            }

            const currentUser = getCurrentUser();
            logActivity(currentUser?.name || 'System', `Recorded purchase from ${document.getElementById('p_supplier').selectedOptions[0]?.text || 'supplier'} - ${purchase.finalKg}kg for UGX ${purchase.totalPayable.toLocaleString()}`);
            closeModal();
            showToast('Purchase saved successfully!', 'success');
            renderPurchases();
            renderDashboard();
        }

        function viewPurchase(id) {
            const purchases = getDB(DB_KEYS.purchases);
            const p = purchases.find(x => x.id === id);
            if (!p) return;
            const suppliers = getDB(DB_KEYS.suppliers);
            const sup = suppliers.find(s => s.id === p.supplierId);
            alert(`Purchase Details:\n\nSupplier: ${sup?.name || 'Unknown'}\nDate: ${p.date}\nFinal Kg: ${p.finalKg}\nTotal: UGX ${p.totalPayable}\nPaid: UGX ${p.amountPaid}\nBalance: UGX ${p.balance}\nStatus: ${p.paymentStatus}\nWarehouse: ${p.warehouse}`);
