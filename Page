                    `<tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:30px;">No customers</td></tr>`;
                return;
            }

            tbody.innerHTML = customers.map(c => {
                const custSales = sales.filter(s => s.customerId === c.id);
                const totalCreditAmount = custSales.reduce((s, s2) => s + s2.total, 0);
                const totalPaid = payments.filter(p => p.customerId === c.id).reduce((s, p) => s + p.amount,
                    0);
                const balance = c.balance || 0;
                const lastSale = custSales.length > 0 ? custSales[0].date : null;
                let aging = 'No sales';
                let agingClass = '';
                if (lastSale) {
                    const days = Math.floor((new Date() - new Date(lastSale)) / (1000 * 60 * 60 * 24));
                    if (days <= 7) { aging = '0-7 days';
                        agingClass = 'badge-ok'; } else if (days <= 14) { aging = '8-14 days';
                        agingClass = 'badge-paid'; } else if (days <= 30) { aging = '15-30 days';
                        agingClass = 'badge-advance'; } else { aging = '30+ Overdue';
                        agingClass = 'badge-overdue'; }
                }
                const status = balance > 0 ? (c.overdueDays > 45 ? 'Blacklisted' : 'Active Credit') : 'Settled';
                const statusClass = balance > 0 ? (c.overdueDays > 45 ? 'badge-overdue' : 'badge-credit') :
                    'badge-paid';
                return `<tr>
                    <td>${c.name}</td>
                    <td>UGX ${totalCreditAmount.toLocaleString()}</td>
                    <td>UGX ${totalPaid.toLocaleString()}</td>
                    <td>UGX ${balance.toLocaleString()}</td>
                    <td><span class="badge-status ${agingClass}">${aging}</span></td>
                    <td><span class="badge-status ${statusClass}">${status}</span></td>
                    <td><button class="btn btn-sm btn-warning" onclick="openPaymentModalFor('${c.id}')">📝 Pay</button></td>
                </tr>`;
            }).join('');
        }

