        function deletePurchase(id) {
            if (!confirm('Delete this purchase?')) return;
            let purchases = getDB(DB_KEYS.purchases);
            purchases = purchases.filter(p => p.id !== id);
            setDB(DB_KEYS.purchases, purchases);
            let inventory = getDB(DB_KEYS.inventory);
            inventory = inventory.filter(i => i.sourceId !== id);
            setDB(DB_KEYS.inventory, inventory);
            showToast('Purchase deleted', 'success');
            renderPurchases();
            renderDashboard();
        }

