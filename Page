        // ============================================================
        function renderFinance() {
            const sales = getDB(DB_KEYS.sales);
            const expenses = getDB(DB_KEYS.expenses);
            const purchases = getDB(DB_KEYS.purchases);
            const payments = getDB(DB_KEYS.payments);

            const totalRevenue = sales.reduce((s, s2) => s + s2.total, 0);
            const totalExpenses = expenses.reduce((s, e) => s + e.amount, 0);
            const totalPurchases = purchases.reduce((s, p) => s + p.totalPayable, 0);
            const totalPaymentsReceived = payments.reduce((s, p) => s + p.amount, 0);
            const totalProfit = totalRevenue - totalExpenses - totalPurchases + totalPaymentsReceived;

            const statsHTML = `
                <div class="stat-card success"><div class="stat-icon">📈</div><div class="stat-label">Total Revenue</div><div class="stat-value">UGX ${totalRevenue.toLocaleString()}</div><div class="stat-sub">From sales</div></div>
                <div class="stat-card info"><div class="stat-icon">💳</div><div class="stat-label">Payments Received</div><div class="stat-value">UGX ${totalPaymentsReceived.toLocaleString()}</div><div class="stat-sub">All collections</div></div>
                <div class="stat-card warning"><div class="stat-icon">📦</div><div class="stat-label">Total Purchases</div><div class="stat-value">UGX ${totalPurchases.toLocaleString()}</div><div class="stat-sub">Cost of goods</div></div>
                <div class="stat-card danger"><div class="stat-icon">🧾</div><div class="stat-label">Total Expenses</div><div class="stat-value">UGX ${totalExpenses.toLocaleString()}</div><div class="stat-sub">Operational costs</div></div>
                <div class="stat-card ${totalProfit >= 0 ? 'success' : 'danger'}"><div class="stat-icon">💰</div><div class="stat-label">Net Profit</div><div class="stat-value">UGX ${totalProfit.toLocaleString()}</div><div class="stat-sub">Revenue - Costs</div></div>
            `;
            document.getElementById('financeStats').innerHTML = statsHTML;

            const summaryHTML = `
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
                    <div style="background:#f8f9fb;padding:20px;border-radius:8px;">
                        <h4 style="margin-bottom:12px;font-weight:700;">📊 Cash Flow</h4>
                        <div class="flex-between" style="padding:6px 0;"><span>Money In (Sales + Payments)</span><strong>UGX ${(totalRevenue + totalPaymentsReceived).toLocaleString()}</strong></div>
                        <div class="flex-between" style="padding:6px 0;border-top:1px solid var(--border);"><span>Money Out (Purchases + Expenses)</span><strong>UGX ${(totalPurchases + totalExpenses).toLocaleString()}</strong></div>
                        <div class="flex-between" style="padding:8px 0;border-top:2px solid var(--accent);margin-top:8px;"><span style="font-weight:700;">Net Cash Flow</span><strong style="color:${totalProfit >= 0 ? 'var(--success)' : 'var(--danger)'};">UGX ${totalProfit.toLocaleString()}</strong></div>
                    </div>
                    <div style="background:#f8f9fb;padding:20px;border-radius:8px;">
                        <h4 style="margin-bottom:12px;font-weight:700;">💡 Key Ratios</h4>
                        <div class="flex-between" style="padding:6px 0;"><span>Avg Sale Value</span><strong>UGX ${sales.length > 0 ? Math.round(totalRevenue / sales.length).toLocaleString() : 0}</strong></div>
                        <div class="flex-between" style="padding:6px 0;border-top:1px solid var(--border);"><span>Total Sales Count</span><strong>${sales.length}</strong></div>
                        <div class="flex-between" style="padding:6px 0;border-top:1px solid var(--border);"><span>Total Purchases Count</span><strong>${purchases.length}</strong></div>
                        <div class="flex-between" style="padding:6px 0;border-top:1px solid var(--border);"><span>Margin %</span><strong>${totalRevenue > 0 ? ((totalProfit / totalRevenue) * 100).toFixed(1) : 0}%</strong></div>
                    </div>
                </div>
            `;
            document.getElementById('financeSummary').innerHTML = summaryHTML;
        }

        // ============================================================
        // REPORTS
        // ============================================================
        function renderReports() {
            const sales = getDB(DB_KEYS.sales);
            const customers = getDB(DB_KEYS.customers);
            const purchases = getDB(DB_KEYS.purchases);
            const suppliers = getDB(DB_KEYS.suppliers);
            const inventory = getDB(DB_KEYS.inventory);
            const expenses = getDB(DB_KEYS.expenses);

            // Best selling grade
            const gradeSales = {};
            sales.forEach(s => { gradeSales[s.grade] = (gradeSales[s.grade] || 0) + s.kgs; });
            const bestGrade = Object.entries(gradeSales).sort((a, b) => b[1] - a[1])[0];

            // Most profitable customer
            const customerProfit = {};
            sales.forEach(s => {
                customerProfit[s.customerId] = (customerProfit[s.customerId] || 0) + s.total;
            });
            const bestCustomerId = Object.entries(customerProfit).sort((a, b) => b[1] - a[1])[0]?.[0];
            const bestCustomer = customers.find(c => c.id === bestCustomerId);

            // Most profitable district (purchases)
            const districtPurchases = {};
            purchases.forEach(p => {
                const sup = suppliers.find(s => s.id === p.supplierId);
                if (sup) districtPurchases[sup.district] = (districtPurchases[sup.district] || 0) + p
                    .totalPayable;
            });
            const bestDistrict = Object.entries(districtPurchases).sort((a, b) => b[1] - a[1])[0];

            // Stock valuation
            const stockValue = inventory.reduce((s, i) => s + (i.kgs * i.trueCostPerKg), 0);

            // Debtors report
            const debtors = customers.filter(c => c.balance > 0);

            const reportsHTML = `
                <div class="stats-grid">
                    <div class="stat-card success"><div class="stat-icon">🏆</div><div class="stat-label">Best Selling Grade</div><div class="stat-value">${bestGrade ? bestGrade[0] : 'N/A'}</div><div class="stat-sub">${bestGrade ? bestGrade[1].toLocaleString() + ' kg' : ''}</div></div>
                    <div class="stat-card info"><div class="stat-icon">👤</div><div class="stat-label">Top Customer</div><div class="stat-value">${bestCustomer ? bestCustomer.name : 'N/A'}</div><div class="stat-sub">${bestCustomer ? 'UGX ' + (customerProfit[bestCustomerId] || 0).toLocaleString() : ''}</div></div>
                    <div class="stat-card warning"><div class="stat-icon">📍</div><div class="stat-label">Top District</div><div class="stat-value">${bestDistrict ? bestDistrict[0] : 'N/A'}</div><div class="stat-sub">${bestDistrict ? 'UGX ' + bestDistrict[1].toLocaleString() : ''}</div></div>
                    <div class="stat-card accent"><div class="stat-icon">🏭</div><div class="stat-label">Stock Valuation</div><div class="stat-value">UGX ${stockValue.toLocaleString()}</div><div class="stat-sub">${inventory.length} items</div></div>
                </div>
                <div class="table-container mt-16">
                    <div class="table-header"><h3>📋 Debtors Report (Who Owes You)</h3></div>
                    <div style="overflow-x:auto;">
                        <table>
                            <thead><tr><th>Customer</th><th>Shop</th><th>Phone</th><th>Balance</th></tr></thead>
                            <tbody>
                                ${debtors.length > 0 ? debtors.map(d => `<tr><td>${d.name}</td><td>${d.shop || '-'}</td><td>${d.phone || '-'}</td><td>UGX ${(d.balance || 0).toLocaleString()}</td></tr>`).join('') : '<tr><td colspan="4" style="text-align:center;padding:30px;color:var(--text-muted);">No debtors - all settled!</td></tr>'}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="table-container mt-16">
                    <div class="table-header"><h3>📊 Sales by Grade</h3></div>
                    <div style="padding:20px;">
                        <div class="chart-bar-container">
                            ${Object.entries(gradeSales).map(([grade, kgs]) => {
                                const maxVal = Math.max(...Object.values(gradeSales)) || 1;
                                const height = (kgs / maxVal) * 100;
                                return `<div class="chart-bar" style="height:${Math.max(height, 5)}%;"><span class="bar-value">${kgs.toLocaleString()}</span><span class="bar-label">${grade}</span></div>`;
                            }).join('') || '<p class="text-muted">No sales data</p>'}
                        </div>
                    </div>
                </div>
                <div class="table-container mt-16">
                    <div class="table-header"><h3>📈 Monthly Expenses Overview</h3></div>
                    <div style="padding:20px;">
                        <div class="chart-bar-container">
                            ${(() => {
                                const monthExpenses = {};
                                expenses.forEach(e => {
                                    const month = e.date?.substring(0,7) || 'Unknown';
                                    monthExpenses[month] = (monthExpenses[month] || 0) + e.amount;
                                });
                                const maxVal = Math.max(...Object.values(monthExpenses)) || 1;
                                return Object.entries(monthExpenses).map(([month, amt]) => {
                                    const height = (amt / maxVal) * 100;
                                    return `<div class="chart-bar" style="height:${Math.max(height, 5)}%;background:#d32f2f;"><span class="bar-value">${(amt/1000).toFixed(0)}k</span><span class="bar-label">${month}</span></div>`;
                                }).join('') || '<p class="text-muted">No expense data</p>';
                            })()}
                        </div>
                    </div>
                </div>
            `;
            document.getElementById('reportsContent').innerHTML = reportsHTML;
        }

        // ============================================================
        // USERS & SECURITY
        // ============================================================
        function renderUsers() {
            const users = getDB(DB_KEYS.users);
            const tbody = document.getElementById('usersTableBody');
            tbody.innerHTML = users.map(u => `
                <tr>
                    <td>${u.name}</td>
                    <td>${u.username}</td>
                    <td><span class="badge-status ${u.role === 'Admin' ? 'badge-overdue' : u.role === 'Cashier' ? 'badge-paid' : 'badge-ok'}">${u.role}</span></td>
                    <td>${u.role === 'Admin' ? 'Full access' : u.role === 'Storekeeper' ? 'Stock only' : u.role === 'Cashier' ? 'Sales & payments' : 'Purchases only'}</td>
                    <td>
                        ${u.username !== 'admin' ? `<button class="btn btn-sm btn-outline" onclick="deleteUser('${u.id}')">🗑️</button>` : '<span class="text-muted">Default</span>'}
                    </td>
                </tr>
            `).join('');

            const activity = getDB(DB_KEYS.activityLog);
            const activityBody = document.getElementById('activityLogBody');
            activityBody.innerHTML = activity.slice(0, 50).map(a => `
                <tr>
                    <td>${new Date(a.timestamp).toLocaleString()}</td>
                    <td>${a.userId}</td>
                    <td>${a.action}</td>
                </tr>
            `).join('') || '<tr><td colspan="3" style="text-align:center;padding:20px;color:var(--text-muted);">No activity</td></tr>';
        }

        function openUserModal() {
            const modalHTML = `
                <div class="modal-header"><h3>👥 Add User</h3><button class="modal-close" onclick="closeModal()">✕</button></div>
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group"><label>Full Name *</label><input type="text" id="u_name"></div>
                        <div class="form-group"><label>Username *</label><input type="text" id="u_username"></div>
                    </div>
                    <div class="form-row">
                        <div class="form-group"><label>Password *</label><input type="password" id="u_password"></div>
                        <div class="form-group"><label>Role *</label><select id="u_role"><option>Storekeeper</option><option>Cashier</option><option>Buyer</option><option>Admin</option></select></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                    <button class="btn btn-primary" onclick="saveUser()">Add User</button>
                </div>
            `;
            document.getElementById('modalContent').innerHTML = modalHTML;
            document.getElementById('modalOverlay').style.display = 'flex';
        }

        function saveUser() {
            const name = document.getElementById('u_name')?.value;
            const username = document.getElementById('u_username')?.value;
            const password = document.getElementById('u_password')?.value;
            const role = document.getElementById('u_role')?.value;
            if (!name || !username || !password) { showToast('Fill all fields', 'error'); return; }

            const users = getDB(DB_KEYS.users);
            if (users.find(u => u.username === username)) { showToast('Username already exists', 'error'); return; }
            users.push({ id: generateId('usr'), name, username, password, role, isLoggedIn: false, _seq: getNextId(
                    DB_KEYS.users) });
            setDB(DB_KEYS.users, users);
            const currentUser = getCurrentUser();
            logActivity(currentUser?.name || 'System', `Added new user: ${name} (${role})`);
            closeModal();
            showToast('User added!', 'success');
            renderUsers();
        }

        function deleteUser(id) {
            if (!confirm('Delete this user?')) return;
            let users = getDB(DB_KEYS.users);
            users = users.filter(u => u.id !== id);
            setDB(DB_KEYS.users, users);
            showToast('User deleted', 'success');
            renderUsers();
        }

        // ============================================================
        // MODAL UTILITIES
        // ============================================================
        function closeModal() {
            document.getElementById('modalOverlay').style.display = 'none';
        }

        function closeModalOnOverlay(event) {
            if (event.target === document.getElementById('modalOverlay')) {
                closeModal();
            }
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            const icon = type === 'success' ? '✅' : type === 'error' ? '❌' : type === 'warning' ? '⚠️' : 'ℹ️';
            toast.innerHTML = `<span>${icon}</span> ${message}`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.animation = 'slideInRight 0.3s ease reverse';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ============================================================
        // SEARCH
        // ============================================================
        function handleSearch(query) {
            if (!query || query.length < 2) return;
            const results = [];
            const customers = getDB(DB_KEYS.customers);
            const suppliers = getDB(DB_KEYS.suppliers);
            const sales = getDB(DB_KEYS.sales);
            const purchases = getDB(DB_KEYS.purchases);

            customers.forEach(c => {
                if (c.name.toLowerCase().includes(query.toLowerCase()) || (c.shop || '').toLowerCase()
                    .includes(query.toLowerCase())) results.push(`Customer: ${c.name} (${c.shop || 'No shop'})`);
            });
            suppliers.forEach(s => {
                if (s.name.toLowerCase().includes(query.toLowerCase()) || (s.district || '').toLowerCase()
                    .includes(query.toLowerCase())) results.push(`Supplier: ${s.name} (${s.district})`);
            });

            if (results.length > 0) {
                showToast(`Found: ${results.slice(0, 3).join(' | ')}`, 'info');
            }
        }

        // ============================================================
        // INIT
        // ============================================================
        document.addEventListener('DOMContentLoaded', () => {
            initializeDatabase();
            // Check if user is already logged in
            const currentUser = getCurrentUser();
            if (currentUser) {
                document.getElementById('loginOverlay').style.display = 'none';
                updateUserInfo();
                renderPage('dashboard');
            } else {
                document.getElementById('loginOverlay').style.display = 'flex';
            }
        });

        // Expose functions to global scope for inline onclick handlers
        window.navigateTo = navigateTo;
        window.toggleSidebar = toggleSidebar;
        window.openPurchaseModal = openPurchaseModal;
        window.openSaleModal = openSaleModal;
        window.openPaymentModal = openPaymentModal;
        window.openPaymentModalFor = openPaymentModalFor;
        window.openExpenseModal = openExpenseModal;
        window.openTransferModal = openTransferModal;
        window.openGradingModal = openGradingModal;
        window.openUserModal = openUserModal;
        window.openEditStockModal = openEditStockModal;
        window.closeModal = closeModal;
        window.closeModalOnOverlay = closeModalOnOverlay;
        window.calcPurchaseNet = calcPurchaseNet;
        window.calcPurchaseBalance = calcPurchaseBalance;
        window.savePurchase = savePurchase;
        window.saveSale = saveSale;
        window.saveExpense = saveExpense;
        window.savePayment = savePayment;
        window.saveTransfer = saveTransfer;
        window.saveGrading = saveGrading;
        window.saveUser = saveUser;
        window.saveStockEdit = saveStockEdit;
        window.updateKgsFromSacks = updateKgsFromSacks;
        window.updateSacksFromKgs = updateSacksFromKgs;
        window.viewPurchase = viewPurchase;
        window.viewSale = viewSale;
        window.deletePurchase = deletePurchase;
        window.deleteSale = deleteSale;
        window.deleteExpense = deleteExpense;
        window.deleteGrading = deleteGrading;
        window.deleteUser = deleteUser;
        window.calcSaleTotal = calcSaleTotal;
        window.handleSearch = handleSearch;
        window.renderPurchases = renderPurchases;
        window.renderSales = renderSales;
        window.renderInventory = renderInventory;
        window.renderGrading = renderGrading;
        window.renderCredit = renderCredit;
        window.renderExpenses = renderExpenses;
        window.renderFinance = renderFinance;
        window.renderReports = renderReports;
        window.renderUsers = renderUsers;
        window.renderDashboard = renderDashboard;
        window.login = login;
        window.logout = logout;
    </script>
</body>
</html>
