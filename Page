        function calcSaleTotal() {
            const kgs = parseFloat(document.getElementById('s_kgs')?.value) || 0;
            const price = parseFloat(document.getElementById('s_price')?.value) || 0;
            const transport = parseFloat(document.getElementById('s_transport')?.value) || 0;
            const total = kgs * price + transport;
            if (document.getElementById('s_total')) document.getElementById('s_total').value = total.toFixed(0);
            const paid = parseFloat(document.getElementById('s_amountPaid')?.value) || 0;
            if (document.getElementById('s_balance')) document.getElementById('s_balance').value = Math.max(0, total -
                paid).toFixed(0);
        }

        function saveSale() {
            const customerId = document.getElementById('s_customer')?.value;
            const grade = document.getElementById('s_grade')?.value;
            const kgs = parseFloat(document.getElementById('s_kgs')?.value) || 0;
            const price = parseFloat(document.getElementById('s_price')?.value) || 0;
            const total = parseFloat(document.getElementById('s_total')?.value) || 0;
            const method = document.getElementById('s_method')?.value || 'Cash';
            const amountPaid = parseFloat(document.getElementById('s_amountPaid')?.value) || 0;
            const balance = parseFloat(document.getElementById('s_balance')?.value) || 0;
            const date = document.getElementById('s_date')?.value || todayStr();

            if (!customerId || kgs <= 0) { showToast('Please fill all required fields', 'error'); return; }

            // Check if inventory has enough stock
            const inventory = getDB(DB_KEYS.inventory);
            const stockItems = inventory.filter(i => i.grade === grade);
            const availableKg = stockItems.reduce((s, i) => s + i.kgs, 0);
            if (kgs > availableKg) { showToast(`Not enough ${grade} in stock! Available: ${availableKg}kg`, 'error'); return; }

            // Deduct from inventory
            let remainingToDeduct = kgs;
            for (let item of stockItems) {
                if (remainingToDeduct <= 0) break;
                const deductFrom = Math.min(item.kgs, remainingToDeduct);
                item.kgs -= deductFrom;
                item.sacks = Math.ceil(item.kgs / 100);
                remainingToDeduct -= deductFrom;
            }
            inventory.filter(i => i.kgs <= 0).forEach(i => inventory.splice(inventory.indexOf(i), 1));
            setDB(DB_KEYS.inventory, inventory);

            const sale = {
                id: generateId('sal'),
                customerId,
                grade,
                kgs,
                pricePerKg: price,
                total,
                transportFee: parseFloat(document.getElementById('s_transport')?.value) || 0,
                paymentMethod: method,
                amountPaid,
                balance,
                date,
                _seq: getNextId(DB_KEYS.sales),
            };
            const sales = getDB(DB_KEYS.sales);
            sales.unshift(sale);
            setDB(DB_KEYS.sales, sales);

            // Update customer balance
            if (balance > 0) {
                const customers = getDB(DB_KEYS.customers);
                const cust = customers.find(c => c.id === customerId);
                if (cust) {
                    cust.balance = (cust.balance || 0) + balance;
                    setDB(DB_KEYS.customers, customers);
                }
            }

            // Record payment if any
            if (amountPaid > 0) {
                const payments = getDB(DB_KEYS.payments);
                payments.unshift({ id: generateId('pay'), customerId, amount: amountPaid, method, date,
                    saleId: sale.id, _seq: getNextId(DB_KEYS.payments) });
                setDB(DB_KEYS.payments, payments);
            }

            const currentUser = getCurrentUser();
            logActivity(currentUser?.name || 'System', `Sold ${kgs}kg ${grade} for UGX ${total.toLocaleString()} - ${method}`);
            closeModal();
            showToast('Sale recorded successfully!', 'success');
            renderSales();
            renderDashboard();
            renderInventory();
        }

        function viewSale(id) {
            const sales = getDB(DB_KEYS.sales);
            const s = sales.find(x => x.id === id);
            if (!s) return;
            const customers = getDB(DB_KEYS.customers);
            const cust = customers.find(c => c.id === s.customerId);
            alert(`Sale Details:\n\nCustomer: ${cust?.name || 'Unknown'}\nDate: ${s.date}\nGrade: ${s.grade}\nKg: ${s.kgs}\nPrice: UGX ${s.pricePerKg}/kg\nTotal: UGX ${s.total}\nPaid: UGX ${s.amountPaid}\nBalance: UGX ${s.balance}\nMethod: ${s.paymentMethod}`);
        }

