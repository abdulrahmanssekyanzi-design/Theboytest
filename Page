    <script>
        // ============================================================
        // DATA LAYER - localStorage based
        // ============================================================
        const DB_KEYS = {
            suppliers: 'bms_suppliers',
            purchases: 'bms_purchases',
            inventory: 'bms_inventory',
            customers: 'bms_customers',
            sales: 'bms_sales',
            payments: 'bms_payments',
            expenses: 'bms_expenses',
            grading: 'bms_grading',
            users: 'bms_users',
            activityLog: 'bms_activity',
            settings: 'bms_settings',
            transfers: 'bms_transfers',
            currentUser: 'bms_currentUserId',
        };

        function getDB(key, fallback = []) {
            try {
                const data = localStorage.getItem(key);
                return data ? JSON.parse(data) : fallback;
            } catch { return fallback; }
        }

        function setDB(key, value) {
            localStorage.setItem(key, JSON.stringify(value));
        }

        function generateId(prefix = 'id') {
            return prefix + '_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);
        }

        function getNextId(entity) {
            const items = getDB(entity);
            return items.length > 0 ? Math.max(...items.map(i => i._seq || 0)) + 1 : 1;
        }

        function logActivity(user, action) {
            const logs = getDB(DB_KEYS.activityLog);
            logs.unshift({
                id: generateId('log'),
                userId: user,
                action: action,
                timestamp: new Date().toISOString()
            });
            if (logs.length > 500) logs.length = 500;
            setDB(DB_KEYS.activityLog, logs);
        }

        function getCurrentUser() {
            const userId = localStorage.getItem(DB_KEYS.currentUser);
            if (userId) {
                const users = getDB(DB_KEYS.users);
                return users.find(u => u.id === userId) || null;
            }
            return null;
        }

        // ============================================================
        // LOGIN / LOGOUT
        // ============================================================
        function login() {
            const username = document.getElementById('loginUsername').value.trim();
            const password = document.getElementById('loginPassword').value;
            const users = getDB(DB_KEYS.users);
            const user = users.find(u => u.username === username && u.password === password);
            if (user) {
                localStorage.setItem(DB_KEYS.currentUser, user.id);
                document.getElementById('loginOverlay').style.display = 'none';
                document.getElementById('loginError').style.display = 'none';
                updateUserInfo();
                renderPage('dashboard');
                showToast(`Welcome, ${user.name}!`, 'success');
                logActivity(user.name, 'Logged in');
            } else {
                document.getElementById('loginError').style.display = 'block';
            }
        }

        function logout() {
            localStorage.removeItem(DB_KEYS.currentUser);
            document.getElementById('loginOverlay').style.display = 'flex';
            document.getElementById('loginPassword').value = '';
            document.getElementById('loginError').style.display = 'none';
            showToast('Logged out successfully', 'info');
        }

        function updateUserInfo() {
            const currentUser = getCurrentUser();
            if (currentUser) {
                document.getElementById('currentUserName').textContent = currentUser.name;
                document.getElementById('currentUserRole').textContent = currentUser.role;
                document.getElementById('userAvatar').textContent = currentUser.name.charAt(0).toUpperCase();
            }
        }

        // ============================================================
        // INITIALIZATION
        // ============================================================
        function initializeDatabase() {
            // Seed users if empty (with new admin password)
            if (getDB(DB_KEYS.users).length === 0) {
                const seedUsers = [
                    { id: 'usr_admin', name: 'Admin', username: 'admin', password: '0756448405@bA', role: 'Admin',
                        isLoggedIn: false, _seq: 1 },
                    { id: 'usr_store', name: 'Store Keeper', username: 'store', password: 'store123',
                        role: 'Storekeeper', isLoggedIn: false, _seq: 2 },
                    { id: 'usr_cash', name: 'Cashier', username: 'cashier', password: 'cash123', role: 'Cashier',
                        isLoggedIn: false, _seq: 3 },
                    { id: 'usr_buyer', name: 'Buyer', username: 'buyer', password: 'buyer123', role: 'Buyer',
                        isLoggedIn: false, _seq: 4 },
                ];
                setDB(DB_KEYS.users, seedUsers);
            } else {
                // Ensure admin password is updated if it still has old default
                const users = getDB(DB_KEYS.users);
                const admin = users.find(u => u.username === 'admin');
                if (admin && admin.password !== '0756448405@bA') {
                    admin.password = '0756448405@bA';
                    setDB(DB_KEYS.users, users);
                }
            }

            // Seed customers if empty
            if (getDB(DB_KEYS.customers).length === 0) {
                const seedCustomers = [
                    { id: 'cust_1', name: 'John Okello', shop: 'Okello Stores', phone: '0772123456',
                        priceGroup: 'VIP', creditLimit: 2000000, balance: 0, _seq: 1 },
                    { id: 'cust_2', name: 'Mary Auma', shop: 'Auma Retail', phone: '0788123456',
                        priceGroup: 'Normal', creditLimit: 500000, balance: 0, _seq: 2 },
                    { id: 'cust_3', name: 'David Ochen', shop: 'Ochen Roasters', phone: '0700123456',
                        priceGroup: 'VIP', creditLimit: 3000000, balance: 0, _seq: 3 },
                ];
                setDB(DB_KEYS.customers, seedCustomers);
            }

            // Seed suppliers if empty
            if (getDB(DB_KEYS.suppliers).length === 0) {
                const seedSuppliers = [
                    { id: 'sup_1', name: 'Peter Odongo', phone: '0771123456', district: 'Lira', village: 'Ogur',
                        _seq: 1 },
                    { id: 'sup_2', name: 'Sarah Achen', phone: '0782123456', district: 'Soroti', village: 'Arapai',
                        _seq: 2 },
                    { id: 'sup_3', name: 'James Okot', phone: '0702123456', district: 'Gulu', village: 'Layibi',
                        _seq: 3 },
                ];
                setDB(DB_KEYS.suppliers, seedSuppliers);
            }

            // Seed settings
            if (!getDB(DB_KEYS.settings, null)) {
                setDB(DB_KEYS.settings, {
                    buyingPricePerKg: 3500,
                    transportPerSack: 15000,
                    offloadingPerSack: 5000,
                    sortingLabourPerSack: 8000,
                    shelledConversionRate: 0.65,
                    lowStockThresholdKg: 500,
                    defaultWarehouse: 'Kisenyi Store 1',
                });
            }

            // Seed inventory if empty
            if (getDB(DB_KEYS.inventory).length === 0) {
                const seedInventory = [
                    { id: 'inv_1', grade: 'Grade 1', warehouse: 'Kisenyi Store 1', sacks: 45, kgs: 4500,
                        trueCostPerKg: 3200, _seq: 1 },
                    { id: 'inv_2', grade: 'Grade 2', warehouse: 'Kisenyi Store 1', sacks: 22, kgs: 2200,
                        trueCostPerKg: 2800, _seq: 2 },
                    { id: 'inv_3', grade: 'Grade 1', warehouse: 'Kisenyi Store 2', sacks: 30, kgs: 3000,
                        trueCostPerKg: 3150, _seq: 3 },
                    { id: 'inv_4', grade: 'Grade 2', warehouse: 'Nakawa', sacks: 15, kgs: 1500, trueCostPerKg: 2750,
                        _seq: 4 },
                ];
                setDB(DB_KEYS.inventory, seedInventory);
            }
        }

        // ============================================================
        // NAVIGATION
        // ============================================================
        function navigateTo(page) {
            if (!getCurrentUser()) return;
            // Update sidebar
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            const navItem = document.querySelector(`.nav-item[data-page="${page}"]`);
            if (navItem) navItem.classList.add('active');

            // Update pages
            document.querySelectorAll('.page').forEach(el => el.style.display = 'none');
            const pageEl = document.getElementById(`page-${page}`);
            if (pageEl) pageEl.style.display = 'block';

            // Update title
            const titles = {
                dashboard: 'Dashboard',
                purchases: 'Purchases',
                inventory: 'Inventory / Warehouse',
                grading: 'Grading & Sorting',
                sales: 'Sales',
                credit: 'Credit & Collections',
                expenses: 'Expenses',
                finance: 'Finance & Profit',
                reports: 'Reports',
                users: 'Users & Security'
            };
            document.getElementById('pageTitle').textContent = titles[page] || 'Dashboard';

            // Close sidebar on mobile
            if (window.innerWidth <= 768) {
                document.getElementById('sidebar').classList.remove('open');
            }

            // Render page
            renderPage(page);
        }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
        }

        function renderPage(page) {
            const renderers = {
                dashboard: renderDashboard,
                purchases: renderPurchases,
                inventory: renderInventory,
                grading: renderGrading,
                sales: renderSales,
                credit: renderCredit,
                expenses: renderExpenses,
                finance: renderFinance,
                reports: renderReports,
                users: renderUsers,
            };
            if (renderers[page]) renderers[page]();
        }

        // ============================================================
        // DASHBOARD
        // ============================================================
        function renderDashboard() {
            const purchases = getDB(DB_KEYS.purchases);
            const sales = getDB(DB_KEYS.sales);
            const expenses = getDB(DB_KEYS.expenses);
            const inventory = getDB(DB_KEYS.inventory);
            const payments = getDB(DB_KEYS.payments);
            const customers = getDB(DB_KEYS.customers);

            const totalStockKg = inventory.reduce((s, i) => s + (i.kgs || 0), 0);
            const totalStockSacks = inventory.reduce((s, i) => s + (i.sacks || 0), 0);
            const cashToday = payments.filter(p => p.date === todayStr()).reduce((s, p) => s + p.amount, 0);
            const debtToday = sales.filter(s => s.date === todayStr() && s.balance > 0).reduce((s, s2) => s + s2
                .balance, 0);
            const totalRevenueToday = sales.filter(s => s.date === todayStr()).reduce((s, s2) => s + s2.total, 0);
            const totalExpensesToday = expenses.filter(e => e.date === todayStr()).reduce((s, e) => s + e.amount, 0);
            const profitToday = totalRevenueToday - totalExpensesToday;

            const lowStockItems = inventory.filter(i => i.kgs < getDB(DB_KEYS.settings, { lowStockThresholdKg: 500 })
                .lowStockThresholdKg);
            const totalCredit = customers.reduce((s, c) => s + (c.balance || 0), 0);
            const overdueCustomers = customers.filter(c => c.balance > 0);

            const statsHTML = `
                <div class="stat-card accent">
                    <div class="stat-icon">📦</div>
                    <div class="stat-label">Total Stock</div>
                    <div class="stat-value">${totalStockKg.toLocaleString()} kg</div>
                    <div class="stat-sub">${totalStockSacks} sacks</div>
                </div>
                <div class="stat-card ${cashToday > 0 ? 'success' : ''}">
                    <div class="stat-icon">💵</div>
                    <div class="stat-label">Cash Today</div>
                    <div class="stat-value">UGX ${cashToday.toLocaleString()}</div>
                    <div class="stat-sub">${todayStr()}</div>
                </div>
                <div class="stat-card ${debtToday > 0 ? 'warning' : ''}">
                    <div class="stat-icon">📊</div>
                    <div class="stat-label">Debt Today</div>
                    <div class="stat-value">UGX ${debtToday.toLocaleString()}</div>
                    <div class="stat-sub">${overdueCustomers.length} customers owe</div>
                </div>
                <div class="stat-card ${profitToday >= 0 ? 'success' : 'danger'}">
                    <div class="stat-icon">📈</div>
                    <div class="stat-label">Profit Today</div>
                    <div class="stat-value">UGX ${profitToday.toLocaleString()}</div>
                    <div class="stat-sub">Revenue: UGX ${totalRevenueToday.toLocaleString()}</div>
                </div>
                <div class="stat-card danger">
                    <div class="stat-icon">⚠️</div>
                    <div class="stat-label">Low Stock Alert</div>
                    <div class="stat-value">${lowStockItems.length}</div>
                    <div class="stat-sub">items below threshold</div>
                </div>
                <div class="stat-card info">
                    <div class="stat-icon">👥</div>
                    <div class="stat-label">Total Customers</div>
                    <div class="stat-value">${customers.length}</div>
                    <div class="stat-sub">Total credit: UGX ${totalCredit.toLocaleString()}</div>
                </div>
            `;
            document.getElementById('dashboardStats').innerHTML = statsHTML;

            // Recent activity
            const activity = getDB(DB_KEYS.activityLog).slice(0, 10);
            const activityHTML = activity.length > 0 ? `
                <table>
                    <thead><tr><th>Time</th><th>User</th><th>Action</th></tr></thead>
                    <tbody>
                        ${activity.map(a => `<tr><td>${new Date(a.timestamp).toLocaleString()}</td><td>${a.userId}</td><td>${a.action}</td></tr>`).join('')}
                    </tbody>
                </table>
            ` : `<div class="empty-state"><div class="empty-icon">📋</div><p>No activity yet</p></div>`;
            document.getElementById('recentActivity').innerHTML = activityHTML;

            // Credit badge
            const overdueBadge = document.getElementById('creditBadge');
            if (overdueCustomers.length > 0) {
                overdueBadge.style.display = 'inline';
                overdueBadge.textContent = overdueCustomers.length;
            } else {
                overdueBadge.style.display = 'none';
            }
        }

        function todayStr() {
            return new Date().toISOString().split('T')[0];
        }

        // ============================================================
