            const g1 = parseFloat(document.getElementById('g_g1')?.value) || 0;
            const g2 = parseFloat(document.getElementById('g_g2')?.value) || 0;
            const reject = parseFloat(document.getElementById('g_reject')?.value) || 0;
            const labour = parseFloat(document.getElementById('g_labour')?.value) || 0;
            const date = document.getElementById('g_date')?.value || todayStr();

            if (!inputId) { showToast('No unsorted stock selected', 'error'); return; }

            const inventory = getDB(DB_KEYS.inventory);
            const inputItem = inventory.find(i => i.id === inputId);
            if (!inputItem) { showToast('Stock item not found', 'error'); return; }

            const inputKg = inputItem.kgs;
            const totalOutput = g1 + g2 + reject;
            if (totalOutput > inputKg) { showToast('Output exceeds input!', 'error'); return; }

            // Remove input item
            inventory.splice(inventory.indexOf(inputItem), 1);

            // Add Grade 1
            if (g1 > 0) {
                inventory.push({ id: generateId('inv'), grade: 'Grade 1', warehouse: inputItem.warehouse,
                    sacks: Math.ceil(g1 / 100), kgs: g1, trueCostPerKg: inputItem.trueCostPerKg + (labour /
                        inputKg), source: 'Sorting', sourceId: inputId, _seq: getNextId(DB_KEYS
                        .inventory) });
            }
            // Add Grade 2
            if (g2 > 0) {
                inventory.push({ id: generateId('inv'), grade: 'Grade 2', warehouse: inputItem.warehouse,
                    sacks: Math.ceil(g2 / 100), kgs: g2, trueCostPerKg: inputItem.trueCostPerKg + (labour /
                        inputKg), source: 'Sorting', sourceId: inputId, _seq: getNextId(DB_KEYS
                        .inventory) });
            }
            // Add Reject
            if (reject > 0) {
                inventory.push({ id: generateId('inv'), grade: 'Reject', warehouse: inputItem.warehouse,
                    sacks: Math.ceil(reject / 100), kgs: reject, trueCostPerKg: 0, source: 'Sorting',
                    sourceId: inputId, _seq: getNextId(DB_KEYS.inventory) });
            }
            setDB(DB_KEYS.inventory, inventory);

            const grading = getDB(DB_KEYS.grading);
            grading.unshift({ id: generateId('gr'), inputKg, grade1Kg: g1, grade2Kg: g2, rejectKg: reject,
                labourCost: labour, date, _seq: getNextId(DB_KEYS.grading) });
            setDB(DB_KEYS.grading, grading);

            const currentUser = getCurrentUser();
            logActivity(currentUser?.name || 'System', `Completed sorting: ${inputKg}kg input → ${g1}kg G1, ${g2}kg G2, ${reject}kg reject`);
            closeModal();
            showToast('Sorting saved!', 'success');
            renderGrading();
            renderInventory();
        }

